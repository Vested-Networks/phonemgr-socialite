{
    "name": "vested-networks/phonemgr-socialite",
    "description": "Sign in with Phone Manager: a Socialite driver for Phone Manager's OpenID Connect provider, and verification of its provisioning tokens.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "socialite",
        "openid-connect",
        "oidc",
        "phone-manager",
        "vested-networks"
    ],
    "homepage": "https://github.com/Vested-Networks/phonemgr-socialite",
    "authors": [
        {
            "name": "Werner Garcia",
            "email": "wgarcia@vestednetworks.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "firebase/php-jwt": "^7.0",
        "illuminate/support": "^12.0|^13.0",
        "laravel/socialite": "^5.32"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "VestedNetworks\\PhoneManager\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "VestedNetworks\\PhoneManager\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "VestedNetworks\\PhoneManager\\PhoneManagerServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
